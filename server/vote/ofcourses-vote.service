[Unit]
Description=OfCourses Vote API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ofcourses-vote
Environment=VOTE_DB_PATH=/var/lib/ofcourses-vote/votes.db
Environment=VOTE_IP_SALT=REPLACE_WITH_RANDOM_SALT
Environment=VOTE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
Environment=VOTE_RATE_LIMIT=20
ExecStart=/opt/ofcourses-vote/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002 --workers 1
Restart=always
RestartSec=3

# 安全加固：仅本地监听 + 最小权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
